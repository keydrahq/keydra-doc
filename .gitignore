# Build output — regenerated by `make docs`.
dist/
.cache/

# Derived from the Keydra source tree by `make docs-source-inventory`. Regenerated on
# every build, never reviewed as content, and carries file paths from the machine that
# produced it.
.generated/

# Rendered PDFs — build artefacts, not sources.
pdf/*.pdf

# Vale's binary and the style packages it downloads. `make docs-lint` fetches these on
# first run, so they are a cache rather than a source — and the RedHat dictionary alone is
# a hundred kilobytes of somebody else's word list.
.vale/bin/
.vale/styles/RedHat/
.vale/styles/AsciiDoc/
.vale/styles/actions/
.vale/styles/dictionaries/

# The vocabulary under config/ is the exception, and it has to be spelled out: it is this
# project's own accept list — the words Vale would otherwise fail the build on — and
# ignoring the whole of config/ meant a fresh clone linted differently from this one.
.vale/styles/config/**
!.vale/styles/config/
!.vale/styles/config/vocabularies/
!.vale/styles/config/vocabularies/Keydra/
!.vale/styles/config/vocabularies/Keydra/**

node_modules/
.yarn/install-state.gz
*.log

# Editors, and the scratch a browser-automation run leaves behind.
.idea/
.vscode/
.playwright-mcp/

# Local-only secrets, if this repository ever grows one.
.env
